<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/find_layout" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="@dimen/dp_48" android:paddingStart="@dimen/dp_16"
  xmlns:android="http://schemas.android.com/apk/res/android">
